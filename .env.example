# Учётка платного поиска ФИПС (информационно-поисковая система, ваш договор).
# Карточка по номеру свидетельства ключа не требует.
# MCP_TRADEMARKS_FIPS_LOGIN=
# MCP_TRADEMARKS_FIPS_PASSWORD=

# Наше размещение — отдельная услуга (не ключ ФИПС).
# MCP_TRADEMARKS_API_KEY=

# Необязательно:
# MCP_TRADEMARKS_FIPS_OPEN_BASE=https://www1.fips.ru/registers-doc-view/fips_servlet
# MCP_TRADEMARKS_API_BASE=https://api.atomno-mcp.ru/trademarks
# MCP_TRADEMARKS_TIMEOUT=30
# MCP_TRADEMARKS_LOG_LEVEL=INFO
